# XY Gateway Docker / Node 环境变量示例
#
# Docker Compose 使用本文件时，请将其复制为 .env：
# cp .env.example .env
#
# 本文件不包含真实密钥，生产环境请替换为随机高强度值。

# 管理员 Root Token
ROOT_TOKEN=replace-with-a-strong-root-token

# 可选：API Key 回显值加密密钥。不设置时首次启动会自动生成并写入数据库。
# 已有实例若曾手动配置过，请继续保留原值，否则无法回显已有 Key。
# KEY_ENCRYPTION_SECRET=

# 安全登录入口。配置后只有该路径返回管理前端，例如 /fdsafhdvd。
# 留空则不启用入口限制，根路径可打开登录页。
SECURE_LOGIN_ENTRY=/fdsafhdvd

# 可选：服务监听端口，默认 8787（Docker）
PORT=8787
